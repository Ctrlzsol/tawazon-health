{
  "name": "tawazon-health",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build_site.mjs && node scripts/generate-sitemap.mjs",
    "check": "node validate.mjs",
    "seo:audit": "node scripts/seo-audit.mjs",
    "seo:production-audit": "node scripts/seo-production-audit.mjs",
    "seo:gsc-manifest": "node scripts/generate-gsc-manifest.mjs",
    "seo:live-audit": "node scripts/seo-live-audit.mjs",
    "seo:verify": "npm run build && npm run seo:audit && npm run seo:content-graph && npm run seo:performance && npm run check && node --check scripts/seo-audit.mjs && node --check scripts/seo-live-audit.mjs && node --check scripts/generate-gsc-manifest.mjs",
    "seo:performance": "node scripts/seo-performance-audit.mjs",
    "seo:content-graph": "node scripts/seo-content-graph-audit.mjs",
    "seo:deep-audit": "node scripts/seo-deep-audit.mjs"
  }
}
