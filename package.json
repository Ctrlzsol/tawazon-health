{
  "name": "tawazon-health",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build_site.mjs && node scripts/generate-sitemap.mjs",
    "check": "node validate.mjs",
    "seo:audit": "node scripts/seo-audit.mjs",
    "seo:production-audit": "node scripts/seo-production-audit.mjs",
    "seo:gsc-manifest": "node scripts/gsc-validation-manifest.mjs https://tawazon-health.vercel.app/sitemap.xml gsc-validation-manifest.json",
    "seo:live-audit": "node scripts/seo-live-audit.mjs",
    "seo:verify": "npm run build && npm run seo:audit && npm run check"
  }
}
